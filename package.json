{
  "name": "medieval-2-tw-script",
  "displayName": "Medieval 2 Synax",
  "description": "Language extension for working with Medieval 2: Total War text files",
  "version": "2.0.0",
  "publisher": "Medik-GH",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Medik-GH/medieval-2-vscode.git"
  },
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "package": "vsce package",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "3.9.2",
    "@types/node": "^18.0.0",
    "typescript": "^5.0.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "tw-script",
        "aliases": [
          "tw-script"
        ],
        "extensions": [
          "campaign_script.txt",
          "export_descr_unit.txt",
          "export_descr_buildings.txt",
          "export_descr_ancillaries.txt",
          "export_descr_character_traits.txt",
          "export_buildings.txt",
          "export_ancillaries.txt",
          "export_traits.txt",
          "export_vnvs.txt",
          "descr_strat.txt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tw-script",
        "scopeName": "source.med",
        "path": "./syntaxes/tw-script.tmLanguage.json"
      }
    ]
  },
  "__metadata": {
    "isApplicationScoped": false,
    "installedTimestamp": 1717509272971,
    "pinned": false,
    "source": "vsix"
  }
}